; Langue de l'interface : en (défaut), fr ou ar
APP_LANG=en

; Domaine du site, sans https:// ni sous-dossier (liens des mails de sécurité)
APP_HOST=

; Base de données : sqlite (défaut) ou mysql
DB_DRIVER=sqlite
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

; Mails de sécurité (connexion, mot de passe oublié) : smtp ou mail
; Valeurs avec caractères spéciaux entre guillemets : SMTP_PASSWORD="p@ss;word"
MAIL_DRIVER=mail
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
