; Environment: prod (default) or dev (debug toolbar, never in production)
APP_ENV=prod

; Interface language: en (default), fr or ar
APP_LANG=en

; Database: sqlite (default) or mysql
DB_DRIVER=sqlite
DB_HOST=
DB_PORT=3306
DB_PREFIX=yw
DB_NAME=
DB_USER=
DB_PASSWORD=

; Security emails (login, password reset): smtp or mail
; Quote values containing special characters: SMTP_PASSWORD="p@ss;word"
MAIL_DRIVER=mail
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
