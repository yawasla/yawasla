{% extends 'install/layout.twig' %}

{% block head %}{{ parent() }}{{ vite('@install/ts/seo.ts') }}{% endblock %}

{% block step %}
    <h2 class="h5 mb-3">{{ 'Website'|trans }}</h2>
    <form method="post" action="{{ path('install') }}" data-shader-ui="form" data-sui-guide>
        {{ csrf() }}
        {% include 'install/global-error.twig' %}
        {% include 'main/partials/field.twig' with {name: 'site_url', label: 'Website address'|trans, type: 'url', required: true, maxlength: 255, help: 'Used for the links in emails. Include the subfolder if there is one.'|trans} %}
        {% include 'main/partials/field.twig' with {name: 'site_name', label: 'Website name'|trans, required: true, maxlength: 255, counter: 60, help: 'Shown as the title in Google: be short and clear.'|trans} %}
        {% include 'main/partials/field.twig' with {name: 'site_description', label: 'Description'|trans, multiline: true, required: true, maxlength: 500, counter: 160, help: 'Shown under the title in Google: say who you are and where.'|trans} %}

        <div class="border rounded p-3 mb-3">
            <p class="small text-body-secondary mb-2">{{ 'Google preview'|trans }}</p>
            <p class="small mb-0" data-preview="field-site_url">https://…</p>
            <p class="h6 text-primary mb-1" data-preview="field-site_name">{{ 'Website name'|trans }}</p>
            <p class="small mb-0" data-preview="field-site_description">{{ 'Description'|trans }}</p>
        </div>

        {% include 'install/buttons.twig' %}
    </form>
{% endblock %}
