<button type="button" class="btn btn-outline-secondary shadow-sm fab theme-fab" data-theme-toggle>
    <span class="theme-toggle-dark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <span class="visually-hidden">{{ 'Dark mode'|trans }}</span>
    </span>
    <span class="theme-toggle-light">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <span class="visually-hidden">{{ 'Light mode'|trans }}</span>
    </span>
</button>
