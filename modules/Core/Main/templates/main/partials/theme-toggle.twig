<button type="button" class="btn btn-outline-secondary shadow-sm fab theme-fab" data-theme-toggle>
    <span class="theme-toggle-dark">{{ icon('moon') }}<span class="visually-hidden">{{ 'Dark mode'|trans }}</span></span>
    <span class="theme-toggle-light">{{ icon('sun') }}<span class="visually-hidden">{{ 'Light mode'|trans }}</span></span>
</button>
