{% extends 'main/layout.twig' %}

{% block head %}{{ vite('@auth/ts/form.ts') }}{% endblock %}

{% block content %}
<main class="bg-body-tertiary min-vh-100 py-4 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5">
                <header class="text-center mb-4">
                    <img src="{{ asset('img/logo_yawasla.webp') }}" alt="Yawasla" class="mb-2" width="88" height="88">
                    <h1 class="h4 mb-3">{{ block('title') }}</h1>
                </header>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        {% block card %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
