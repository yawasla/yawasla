{% extends 'auth/layout.twig' %}

{% block title %}{{ 'Reset password'|trans }}{% endblock %}

{% block card %}
    <form method="post" action="{{ path('login_reset_token', {token: token}) }}" data-shader-ui="form" data-sui-guide>
        {{ csrf() }}
        {% include 'auth/global-error.twig' %}
        {% include 'main/partials/field.twig' with {name: 'password', label: 'New password'|trans, type: 'password', required: true, autocomplete: 'new-password', help: 'At least %min% characters, including a digit and a symbol.'|trans({'%min%': constant('Yawasla\\Auth\\Password::MIN_LENGTH')})} %}
        {% include 'main/partials/field.twig' with {name: 'password_confirm', label: 'Confirm password'|trans, type: 'password', required: true, autocomplete: 'new-password'} %}
        <button type="submit" class="btn btn-primary w-100 mt-2">{{ 'Change password'|trans }}</button>
    </form>
{% endblock %}
