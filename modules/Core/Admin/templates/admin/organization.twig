{% extends 'admin/layout.twig' %}

{% block title %}{{ organization ? organization.name : 'New organization'|trans }}{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-12 col-lg-9 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post" data-shader-ui="form" data-sui-guide action="{{ organization ? path('admin_organizations_edit', {id: organization.id}) : path('admin_organizations_new') }}">
                        {{ csrf() }}
                        {% include 'main/partials/form-error.twig' %}
                        {% include 'main/partials/organization-fields.twig' with {full: true} %}
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
                            <a class="btn btn-outline-secondary" href="{{ path('admin_organizations') }}">{{ 'Cancel'|trans }}</a>
                            {% if organization and organization.parent_id %}
                                <button type="submit" form="organization-delete" class="btn btn-outline-danger ms-auto">{{ icon('trash') }} {{ 'Delete'|trans }}</button>
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>
            {% if organization and organization.parent_id %}
                <form method="post" id="organization-delete" action="{{ path('admin_organizations_delete', {id: organization.id}) }}">
                    {{ csrf() }}
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
